# Tina CMS Configuration
# Get these values from your project at app.tina.io
# 1. Create account at https://app.tina.io
# 2. Create project and connect to this GitHub repository
# 3. Go to Project Settings > Tokens to find/generate these values

NEXT_PUBLIC_TINA_CLIENT_ID=your-client-id-here
TINA_TOKEN=your-content-token-here

# Branch name - usually "main" for production
NEXT_PUBLIC_TINA_BRANCH=main

# Cloudinary Configuration (required for image uploads)
# Get these from your Cloudinary dashboard at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret