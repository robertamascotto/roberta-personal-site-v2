# Sanity CMS
# Get these from https://www.sanity.io/manage — select the project, then
# API tab for the project ID/token, and Datasets tab for the dataset name.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-editor-or-admin-token

# Any random string — used to authorize the /api/revalidate webhook and
# /api/draft preview links. Generate one with: openssl rand -hex 24
SANITY_REVALIDATE_SECRET=your-random-secret

# Formspree (contact form) — form ID from https://formspree.io
NEXT_PUBLIC_FORMSPREE_ID=your-formspree-form-id

# Production site URL, used for canonical links, sitemap, and OG tags
NEXT_PUBLIC_SITE_URL=https://www.robertamascotto.com
